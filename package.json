{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:tv": "vite --mode tv",
    "build": "node scripts/copy-ffmpeg.mjs && tsc -b && vite build",
    "build:tv": "node scripts/copy-ffmpeg.mjs && tsc -b && vite build --mode tv",
    "tv:package": "ares-package webos --outdir webos/out",
    "tv:install": "ares-install --device tv webos/out/com.groloo.web_1.0.0_all.ipk",
    "tv:launch": "ares-launch --device tv com.groloo.web",
    "lint": "oxlint",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "preview": "vite preview",
    "shots:record": "node scripts/tv-shots.mjs --record",
    "shots:baseline": "node scripts/tv-shots.mjs --baseline",
    "shots:check": "node scripts/tv-shots.mjs --check",
    "shots:check:prod": "vite preview --port 4173 & sleep 3; SHOT_URL=http://localhost:4173 node scripts/tv-shots.mjs --check",
    "postinstall": "node scripts/copy-ffmpeg.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@tanstack/react-query": "^5.101.2",
    "mediabunny": "^1.52.3",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^6.30.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.61.1",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
